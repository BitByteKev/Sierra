---
import { NAV, SITE } from '../lib/site';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<header class="sticky top-0 z-40 backdrop-blur bg-[var(--color-bone)]/85 border-b border-[var(--color-sage-100)]/60">
  <div class="container-prose flex items-center justify-between py-4">
    <a href="/" class="flex items-center gap-3 group">
      <img src="/logo.avif" alt="Sierra Verde Landscaping logo" width="44" height="44" class="h-11 w-auto" />
      <span class="font-display text-2xl tracking-tight group-hover:text-[var(--color-sage-700)] transition">
        Sierra Verde
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-8" aria-label="Primary">
      {NAV.filter(n => n.href !== '/').map((item) => (
        <a
          href={item.href}
          class={`text-sm font-medium tracking-wide uppercase transition ${
            isActive(item.href)
              ? 'text-[var(--color-sage-700)]'
              : 'text-[var(--color-charcoal)] hover:text-[var(--color-sage-700)]'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href={`tel:${SITE.phoneTel}`} class="hidden sm:inline-flex btn-outline !py-2 !px-4 text-xs">
        {SITE.phone}
      </a>
      <a href="/contact/" class="btn-primary !py-2 !px-4 text-xs">Free Quote</a>
    </div>
  </div>
</header>

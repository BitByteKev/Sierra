---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../lib/site';
---
<Layout title={`Page not found | ${SITE.name}`} description="The page you're looking for doesn't exist.">
  <section class="container-prose py-32 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 font-display text-6xl">Lost in the garden.</h1>
    <p class="mt-6 max-w-md mx-auto text-[var(--color-charcoal)]/70 leading-relaxed">
      The page you were looking for doesn't exist anymore. Head back home or pick up the phone — we're easy to reach.
    </p>
    <div class="mt-10 flex justify-center gap-4 flex-wrap">
      <a href="/" class="btn-primary">Back to Home</a>
      <a href="/contact/" class="btn-outline">Contact Us</a>
    </div>
  </section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../lib/site';
---
<Layout
  title={`Contact Sierra Verde Landscaping | ${SITE.cityServed}, CA`}
  description={`Get a free landscaping quote from Sierra Verde. Call ${SITE.phone} or send a request — we respond to most quotes the same day.`}
>
  <PageHeader
    eyebrow="Get in touch"
    title="Let's talk about your yard."
    intro="Send us a quick note about your property. We respond to most quote requests the same day. Prefer to talk? Call or text Gabriel directly."
  />

  <section class="container-prose pb-24 grid lg:grid-cols-5 gap-12">
    <!-- Form -->
    <div class="lg:col-span-3">
      <form
        class="rounded-3xl bg-cream border border-[var(--color-sage-100)] p-8 md:p-10 shadow-sm space-y-6"
        onsubmit="event.preventDefault(); this.querySelector('[data-success]').classList.remove('hidden'); this.querySelector('[data-form-body]').classList.add('hidden');"
        aria-labelledby="quote-form-title"
      >
        <h2 id="quote-form-title" class="font-display text-3xl text-[var(--color-sage-900)]">Request a free quote</h2>

        <div data-form-body class="space-y-5">
          <div class="grid sm:grid-cols-2 gap-5">
            <label class="block">
              <span class="block text-sm font-medium mb-1">First name *</span>
              <input
                type="text"
                name="firstName"
                required
                class="w-full rounded-xl border border-[var(--color-sage-100)] bg-[var(--color-bone)] px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-sage-300)] focus:border-transparent"
              />
            </label>
            <label class="block">
              <span class="block text-sm font-medium mb-1">Last name</span>
              <input
                type="text"
                name="lastName"
                class="w-full rounded-xl border border-[var(--color-sage-100)] bg-[var(--color-bone)] px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-sage-300)] focus:border-transparent"
              />
            </label>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <label class="block">
              <span class="block text-sm font-medium mb-1">Phone *</span>
              <input
                type="tel"
                name="phone"
                required
                class="w-full rounded-xl border border-[var(--color-sage-100)] bg-[var(--color-bone)] px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-sage-300)] focus:border-transparent"
              />
            </label>
            <label class="block">
              <span class="block text-sm font-medium mb-1">Email</span>
              <input
                type="email"
                name="email"
                class="w-full rounded-xl border border-[var(--color-sage-100)] bg-[var(--color-bone)] px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-sage-300)] focus:border-transparent"
              />
            </label>
          </div>

          <label class="block">
            <span class="block text-sm font-medium mb-1">Property address</span>
            <input
              type="text"
              name="address"
              placeholder="Street, City, ZIP"
              class="w-full rounded-xl border border-[var(--color-sage-100)] bg-[var(--color-bone)] px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-sage-300)] focus:border-transparent"
            />
          </label>

          <fieldset>
            <legend class="block text-sm font-medium mb-2">What can we help with?</legend>
            <div class="grid sm:grid-cols-2 gap-2">
              {['Lawn maintenance', 'Irrigation', 'Hedge trimming', 'Weed control', 'Pruning', 'Other / not sure'].map((opt) => (
                <label class="flex items-center gap-2 text-sm">
                  <input type="checkbox" name="services" value={opt} class="accent-[var(--color-sage-700)]" />
                  {opt}
                </label>
              ))}
            </div>
          </fieldset>

          <label class="block">
            <span class="block text-sm font-medium mb-1">Tell us about your yard</span>
            <textarea
              name="message"
              rows="4"
              placeholder="Lot size, current state, any specific concerns…"
              class="w-full rounded-xl border border-[var(--color-sage-100)] bg-[var(--color-bone)] px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-sage-300)] focus:border-transparent"
            ></textarea>
          </label>

          <button type="submit" class="btn-primary w-full sm:w-auto">
            Send request
          </button>

          <p class="text-xs text-[var(--color-charcoal)]/50">
            By submitting, you agree to be contacted about your quote. We never share your info.
          </p>
        </div>

        <div data-success class="hidden text-center py-8">
          <div class="text-4xl mb-2" aria-hidden="true">🌱</div>
          <h3 class="font-display text-2xl text-[var(--color-sage-900)]">Thanks — we got it.</h3>
          <p class="mt-2 text-[var(--color-charcoal)]/70">Gabriel will reach out within one business day to schedule a walk-through.</p>
        </div>
      </form>
    </div>

    <!-- Contact info sidebar -->
    <aside class="lg:col-span-2 space-y-6">
      <div class="rounded-3xl bg-[var(--color-sage-900)] text-cream p-8">
        <p class="eyebrow !text-[var(--color-sage-300)]">Call or text</p>
        <a href={`tel:${SITE.phoneTel}`} class="mt-2 block font-display text-4xl hover:text-[var(--color-sage-300)] transition">
          {SITE.phone}
        </a>
        <p class="mt-3 text-cream/80 text-sm">Mon–Fri 7am–6pm · Sat 8am–2pm</p>
      </div>

      <div class="rounded-3xl bg-cream border border-[var(--color-sage-100)] p-8">
        <p class="eyebrow">Email</p>
        <a href={`mailto:${SITE.email}`} class="mt-2 block text-lg hover:text-[var(--color-sage-700)] transition break-all">
          {SITE.email}
        </a>
      </div>

      <div class="rounded-3xl bg-cream border border-[var(--color-sage-100)] p-8">
        <p class="eyebrow">Service area</p>
        <p class="mt-2 text-[var(--color-charcoal)]/80">San Diego, CA</p>
        <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm text-[var(--color-charcoal)]/70">
          {SITE.serviceAreas.map((a) => <li>· {a}</li>)}
        </ul>
      </div>
    </aside>
  </section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Testimonial from '../components/Testimonial.astro';
import CTASection from '../components/CTASection.astro';
import { SITE } from '../lib/site';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order
);
const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const testimonials = (await getCollection('testimonials')).sort(
  (a, b) => a.data.order - b.data.order
);
---
<Layout
  title={`San Diego Landscaping & Lawn Care | ${SITE.name}`}
  description="Family-owned landscaping in San Diego. Lawn maintenance, irrigation, pruning, and hedge trimming for La Jolla, North Park, Kensington & more. Free quote."
>
  <Hero />

  <!-- Services -->
  <section class="container-prose py-24" id="services">
    <div class="flex items-end justify-between gap-6 mb-12 flex-wrap">
      <div>
        <p class="eyebrow">What we do</p>
        <h2 class="mt-3 font-display text-4xl md:text-5xl max-w-2xl leading-tight">
          The full landscape maintenance experience.
        </h2>
      </div>
      <p class="max-w-md text-[var(--color-charcoal)]/70 leading-relaxed">
        Weekly upkeep, restoration projects, irrigation, and design work — handled by the same small team that's been together since 2021.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <ServiceCard
          title={s.data.title}
          description={s.data.description}
          href={`/services/${s.id}/`}
          icon={s.data.icon}
        />
      ))}
    </div>
  </section>

  <!-- Story -->
  <section class="bg-[var(--color-bone-2)] py-24">
    <div class="container-prose grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="eyebrow">Community. Values. Long-lasting relationships.</p>
        <h2 class="mt-3 font-display text-4xl md:text-5xl leading-tight">
          Meet Gabriel.
        </h2>
        <p class="mt-6 text-[var(--color-charcoal)]/80 leading-relaxed">
          Sierra Verde Landscaping is a family-owned business serving San Diego residential and commercial properties since 2021. Gabriel started the company on the belief that good landscaping is about showing up — consistently, on time, with care — for the same clients year after year.
        </p>
        <p class="mt-4 text-[var(--color-charcoal)]/80 leading-relaxed">
          That's how every account is run today: the same crew sees your property every visit, learns what works for your specific yard, and takes ownership of the long-term result.
        </p>
        <a href="/about/" class="mt-8 inline-flex btn-outline">Read Gabriel's Story</a>
      </div>
      <div class="relative">
        <div class="absolute -inset-4 rounded-3xl bg-[var(--color-sage-300)]/40 -rotate-2" aria-hidden="true"></div>
        <img
          src="https://images.unsplash.com/photo-1605648916361-9bc12ad6a569?auto=format&fit=crop&w=1200&q=80"
          alt="Landscaper Gabriel inspecting a freshly trimmed San Diego front yard"
          class="relative rounded-3xl shadow-xl"
          width="1200"
          height="900"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Featured projects -->
  <section class="container-prose py-24">
    <div class="flex items-end justify-between gap-6 mb-12 flex-wrap">
      <div>
        <p class="eyebrow">Recent work</p>
        <h2 class="mt-3 font-display text-4xl md:text-5xl max-w-2xl leading-tight">
          A few yards we're proud of.
        </h2>
      </div>
      <a href="/our-work/" class="btn-outline">See All Projects</a>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      {projects.map((p) => (
        <article class="group">
          <div class="overflow-hidden rounded-2xl">
            <img
              src={p.data.image}
              alt={p.data.imageAlt}
              class="w-full h-64 object-cover group-hover:scale-105 transition duration-500"
              loading="lazy"
              width="1600"
              height="1200"
            />
          </div>
          <p class="mt-4 eyebrow">{p.data.neighborhood}</p>
          <h3 class="mt-1 font-display text-2xl">{p.data.title}</h3>
          <p class="mt-2 text-sm text-[var(--color-charcoal)]/70 leading-relaxed">{p.data.description}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-[var(--color-bone-2)] py-24">
    <div class="container-prose">
      <p class="eyebrow text-center">Why clients stay</p>
      <h2 class="mt-3 text-center font-display text-4xl md:text-5xl leading-tight max-w-2xl mx-auto">
        Real reviews from real San Diego neighbors.
      </h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {testimonials.map((t) => (
          <Testimonial
            quote={t.data.quote}
            author={t.data.author}
            neighborhood={t.data.neighborhood}
          />
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</Layout>

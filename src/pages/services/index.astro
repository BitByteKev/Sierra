---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTASection from '../../components/CTASection.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../lib/site';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order
);
---
<Layout
  title={`Services | San Diego Landscape Maintenance | ${SITE.name}`}
  description="Sierra Verde Landscaping services in San Diego: lawn maintenance, irrigation install and repair, hedge trimming, weed control, and pruning. Family-owned since 2021."
>
  <PageHeader
    eyebrow="Services"
    title="Everything we do, with the same small crew."
    intro="We're a full-service landscape maintenance company — same team every visit, no rotating crews, no sub-contracting."
  />

  <section class="container-prose pb-24">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <ServiceCard
          title={s.data.title}
          description={s.data.description}
          href={`/services/${s.id}/`}
          icon={s.data.icon}
        />
      ))}
    </div>
  </section>

  <CTASection />
</Layout>
